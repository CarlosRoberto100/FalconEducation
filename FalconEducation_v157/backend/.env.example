# Copia este ficheiro para ".env" e ajusta os valores conforme o ambiente.

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=falconeducation
DB_PORT=3306
PORT=5000

# Segredo usado para assinar/verificar os tokens JWT. OBRIGATÓRIO — o
# servidor não arranca sem esta variável (ver config/jwt.js). Em produção,
# use uma string longa e aleatória (ex.: gerada com `openssl rand -hex 32`).
JWT_SECRET=

# Origem(ns) do frontend autorizada(s) pelo CORS. Separe por vírgula se
# houver mais de uma (ex.: domínio de produção + ambiente de preview).
FRONTEND_URL=http://localhost:5173

# "development" (padrão) ou "production". Em produção, esconde detalhes de
# erro interno das respostas ao cliente (ver o handler de erro em app.js).
NODE_ENV=development

# v96 — Envio automático de comprovativos (matrícula/renovação/pagamento) por
# WhatsApp ao encarregado, via WhatsApp Business Cloud API (Meta). Sem estas
# duas variáveis, o recurso fica silenciosamente desligado (os PDFs continuam
# a poder ser descarregados normalmente, só o envio automático não acontece).
# Como obter: crie uma app em developers.facebook.com > WhatsApp > API Setup.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Opcional — versão da Graph API (default: v21.0)
WHATSAPP_API_VERSION=v21.0
# Opcional — indicativo do país usado quando o telefone do encarregado é
# guardado sem indicativo (default: 258, Moçambique)
WHATSAPP_DEFAULT_COUNTRY_CODE=258

# v112 — Backup real da base de dados (Sistema de Backup, painel Super
# Admin). Requer o cliente mysqldump instalado no servidor.
# BACKUP_DIR: pasta onde os ficheiros .sql de backup são gravados.
#   Padrão (se não definido): ./backups, dentro da pasta do backend.
# MYSQLDUMP_PATH: caminho do binário mysqldump, se não estiver no PATH.
#   Padrão: "mysqldump".
BACKUP_DIR=
MYSQLDUMP_PATH=
